{
  "name": "khaodee",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Open-source POS + accounting for Thai retail shops",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev:server": "pnpm --filter @khaodee/server dev",
    "dev:cashier": "pnpm --filter @khaodee/cashier dev",
    "dev:admin": "pnpm --filter @khaodee/admin dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
